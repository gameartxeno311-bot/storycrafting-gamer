# Copy this file to config/.env and fill in your X OAuth 2.0 Client ID.
# Create/configure the X app in the X Developer Portal.
X_CLIENT_ID=YOUR_X_OAUTH2_CLIENT_ID
X_REDIRECT_URI=http://127.0.0.1:8765/callback

# Obsidian Local REST API
OBSIDIAN_URL=https://127.0.0.1:27124
OBSIDIAN_API_KEY=YOUR_OBSIDIAN_API_KEY
OBSIDIAN_MEMORY_NOTE=Storycrafting Gamer/AI Memory.md
